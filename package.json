{
  "name": "worktree-dashboard",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "tauri": "tauri",
    "build": "vite build",
    "serve": "vite preview",
    "dev": "vite",
    "worktree:dashboard:ui": "vite --open /worktree-dashboard.html",
    "worktree:dashboard": "node --watch worktree-dashboard/worktree-dashboard.mjs",
    "worktree:mcp": "node worktree-dashboard/worktree-dashboard-mcp.mjs",
    "setup-env": "node scripts/setup-env.mjs",
    "test": "node --test scripts/*.node.test.mjs",
    "test:webui-playwright": "node scripts/run-playwright.mjs test",
    "lint": "npx @biomejs/biome check webui/ scripts/ worktree-dashboard/ --formatter-enabled=false",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "fkill": "^10.0.3",
    "nanostores": "^1.5.5",
    "pid-port": "^2.2.0",
    "preline": "^5.1.0",
    "solid-js": "^1.9.19",
    "tailwindcss": "^4.3.5",
    "toastify-js": "^1.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/toastify-js": "^1.12.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.16"
  }
}
