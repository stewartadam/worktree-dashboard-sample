{
  "name": "worktree-dashboard",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "tauri": "tauri",
    "build": "vite build",
    "serve": "vite preview",
    "dev": "vite --open /worktree-dashboard.html",
    "worktree:dashboard:ui": "vite",
    "worktree:dashboard": "node --watch worktree-dashboard/worktree-dashboard.mjs",
    "worktree:mcp": "node worktree-dashboard/worktree-dashboard-mcp.mjs",
    "worktree:stop-services": "node scripts/stop-processes.mjs",
    "setup-env": "node scripts/setup-env.mjs",
    "test:webui-playwright": "node scripts/run-playwright.mjs test",
    "lint": "npx @biomejs/biome check webui/ scripts/ worktree-dashboard/ --formatter-enabled=false",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.6",
    "fkill": "^10.0.3",
    "nanostores": "^1.0.1",
    "pid-port": "^2.0.1",
    "preline": "^4.1.3",
    "solid-js": "^1.9.11",
    "tailwindcss": "^4.1.4",
    "toastify-js": "^1.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.4.1",
    "@types/node": "^24.12.2",
    "@types/toastify-js": "^1.12.4",
    "tw-animate-css": "^1.3.3",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.6"
  }
}
