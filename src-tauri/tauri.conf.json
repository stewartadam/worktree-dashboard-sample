{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sample App",
  "version": "0.1.0",
  "identifier": "com.example.worktree-dashboard",
  "build": {
    "frontendDist": "../webui/dist",
    "devUrl": "http://localhost:3031/",
    "beforeBuildCommand": "npm run build",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "title": "Sample App",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
